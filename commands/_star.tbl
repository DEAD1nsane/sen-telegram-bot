if (message && message.text) {
  const text = message.text.toLowerCase();

  if (text.includes("sen")) {
    bot.sendAudio(message.chat.id, "Devin_The_Dude_Anythang.mp3", {
      reply_to_message_id: message.message_id
    });
  } else if (text.includes("magic")) {
    bot.sendAudio(message.chat.id, "Do You Believe In Magic.mp3", {
      reply_to_message_id: message.message_id
    });
  }
}
